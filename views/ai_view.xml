<odoo>
    <record id="view_note_note_form_inherit_ai" model="ir.ui.view">
        <field name="name">note.note.form.inherit.ai</field>
        <field name="model">note.note</field>
        <field name="inherit_id" ref="note.view_note_note_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_create_information" 
                        string="Crear Contenido con IA" 
                        type="object" 
                        class="oe_highlight"
                        [cite_start]icon="fa-magic"/> [cite: 12, 13]
                <button name="action_edit_existing_content" 
                        string="Editar con IA" 
                        type="object" 
                        [cite_start]icon="fa-pencil"/> [cite: 14]
            </xpath>
        </field>
    </record>
</odoo>