<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_ai_contacts" model="ir.actions.act_window">
        <field name="name">Gestión de Contactos con IA</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_ai_editor_root" name="IA Editor Pro" action="action_ai_contacts" sequence="1"/>

    <record id="view_partner_form_ai_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.ai.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_generate_ai_description" 
                            string="IA: Generar Descripción" 
                            type="object" 
                            class="oe_highlight"/>
                    <button name="action_improve_ai_text" 
                            string="IA: Mejorar Texto" 
                            type="object"/>
                </header>
            </xpath>
        </field>
    </record>
</odoo>