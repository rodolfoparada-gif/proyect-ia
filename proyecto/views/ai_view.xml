<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_ai_contacts" model="ir.actions.act_window">
        <field name="name">Asistente IA</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_ai_editor_root"
              name="IA Editor Pro"
              action="action_ai_contacts"
              sequence="1"/>

    <record id="view_partner_form_ai_simple" model="ir.ui.view">
        <field name="name">res.partner.form.ai.simple</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <div class="oe_edit_only mt-3 p-2 border-top">
                    <label string="Acciones IA" class="fw-bold"/>
                    <button name="action_generate_ai_description" 
                            string="Generar Descripción" 
                            type="object" 
                            class="btn btn-primary mx-2"/>
                    <button name="action_improve_ai_text" 
                            string="Mejorar Texto" 
                            type="object" 
                            class="btn btn-secondary"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>