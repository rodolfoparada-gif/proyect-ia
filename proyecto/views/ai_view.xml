<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_ai_editor_pro" model="ir.actions.act_window">
        <field name="name">Editor de Documentos IA</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False}</field>
    </record>

    <menuitem id="menu_ai_editor_root" 
              name="IA Editor Pro" 
              action="action_ai_editor_pro" 
              sequence="1"/>

    <record id="view_partner_form_ai_pro" model="ir.ui.view">
        <field name="name">res.partner.form.ai.pro</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="create">0</attribute>
            </xpath>

            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_generate_ai_description" 
                            string="CREAR INFORMACIÓN" 
                            type="object" 
                            class="btn-primary"/>
                    <button name="action_improve_ai_text" 
                            string="EDITAR DOCUMENTO" 
                            type="object" 
                            class="btn-secondary"/>
                </header>
            </xpath>
        </field>
    </record>
</odoo>