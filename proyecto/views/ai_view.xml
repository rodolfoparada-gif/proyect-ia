<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ia_document_form" model="ir.ui.view">
        <field name="name">ia.document.form</field>
        <field name="model">ia.document</field>
        <field name="arch" type="xml">
            <form string="Editor de Documentos IA">
                <header>
                    <button name="action_generate_info" 
                            string="Crear Información" 
                            type="object" 
                            class="oe_highlight" 
                            confirm="¿Desea generar contenido nuevo basado en el título, Mi Señor?"/>
                    
                    <button name="action_edit_doc" 
                            string="Editar Documento (Mejorar)" 
                            type="object" 
                            class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Título del Documento"/>
                        <h1>
                            <field name="name" placeholder="Ej: Manual de Programación en Python..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date_created" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Contenido del Documento" name="content_page">
                            <field name="content" 
                                   widget="html" 
                                   options="{'style-inline': true}" 
                                   placeholder="El contenido generado aparecerá aquí..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ia_document_list" model="ir.ui.view">
        <field name="name">ia.document.list</field>
        <field name="model">ia.document</field>
        <field name="arch" type="xml">
            <list string="Mis Documentos IA"> <field name="name"/>
                <field name="date_created"/>
            </list>
        </field>
    </record>

    <record id="action_ia_document" model="ir.actions.act_window">
        <field name="name">Documentos con IA</field>
        <field name="res_model">ia.document</field>
        <field name="view_mode">list,form</field> <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Cree su primer documento, Mi Señor.
            </p>
            <p>
                Escriba un título y use el botón 'Crear Información' para que la IA trabaje por usted.
            </p>
        </field>
    </record>

    <menuitem id="menu_ia_root" 
              name="Redactor IA" 
              sequence="10"/>

    <menuitem id="menu_ia_document" 
              name="Mis Documentos" 
              parent="menu_ia_root" 
              action="action_ia_document" 
              sequence="10"/>
</odoo>