<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_ai_contacts" model="ir.actions.act_window">
        <field name="name">Gestión de Contactos con IA</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form,kanban</field>
    </record>

    <menuitem id="menu_ai_editor_root"
              name="IA Editor Pro"
              action="action_ai_contacts"
              sequence="1"/>

    <record id="view_partner_form_ai_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.ai.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='internal_notes']" position="before">
                <div class="alert alert-info" role="alert" style="margin-bottom: 10px;">
                    <strong>Asistente IA:</strong> Use los botones para procesar texto.
                    <button name="action_generate_ai_description" 
                            string="Generar Descripción" 
                            type="object" 
                            class="btn btn-primary btn-sm mx-2"/>
                    <button name="action_improve_ai_text" 
                            string="Mejorar Texto" 
                            type="object" 
                            class="btn btn-secondary btn-sm"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>