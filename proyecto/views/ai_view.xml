<odoo>
    <record id="action_ai_editor" model="ir.actions.act_window">
        <field name="name">IA Editor Pro</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea un contacto para empezar a usar la IA
            </p>
        </field>
    </record>

    <menuitem id="menu_ai_root" 
              name="IA Editor" 
              web_icon="base,static/description/icon.png"
              action="action_ai_editor"
              sequence="10"/>

    <record id="view_partner_form_inherit_ai" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.ai</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_create_information" 
                            string="IA: Generar Descripción" 
                            type="object" 
                            class="oe_highlight"/>
                    <button name="action_edit_existing_content" 
                            string="IA: Mejorar Texto" 
                            type="object"/>
                </header>
            </xpath>
        </field>
    </record>
</odoo>